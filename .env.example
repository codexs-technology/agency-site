# Copy server secrets to .dev.vars for local use only. Never commit actual values.
ENVIRONMENT=development
PUBLIC_SITE_URL=http://localhost:8787
# Explicit bypass accepted only on localhost in development.
LOCAL_TEST_MODE=true
ADMIN_BOOTSTRAP_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM=
NOTIFICATION_EMAIL=codexstechnology@gmail.com
SEND_CONFIRMATIONS=false
# D1 binding DB is configured in wrangler.jsonc, not an API key.
# Recruitment: private server-only Apps Script secrets. Never put in VITE variables.
CAREERS_WEBHOOK_URL=
CAREERS_WEBHOOK_SECRET=
# Enable only after privacy approval and actual Gmail integration verification.
APPLICATION_UPLOADS_APPROVED=false