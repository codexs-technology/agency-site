# Copy server secrets to .dev.vars for local use only. Never commit actual values.
ENVIRONMENT=development
PUBLIC_SITE_URL=http://localhost:8787
# Explicit bypass accepted only on localhost in development.
LOCAL_TEST_MODE=true
ADMIN_BOOTSTRAP_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM=
NOTIFICATION_EMAIL=codexstechnology@gmail.com
SEND_CONFIRMATIONS=false
# D1 binding DB is configured in wrangler.jsonc, not an API key.
# Recruitment: private server-only Apps Script secrets. Never put in VITE variables.
CAREERS_WEBHOOK_URL=
CAREERS_WEBHOOK_SECRET=
# Enable only after privacy approval and actual Gmail integration verification.
APPLICATION_UPLOADS_APPROVED=false
# PayMeGate online payment. Off unless PAYMENTS_ENABLED is exactly "true".
# Non-secret settings (plain variables). See docs/PAYMEGATE_INTEGRATION.md.
PAYMENTS_ENABLED=false
PAYMEGATE_MODE=sandbox
PAYMEGATE_API_BASE_URL=https://api.codesboxs.com/v1
PAYMEGATE_CHECKOUT_ORIGIN=https://pay.codesboxs.com
PAYMEGATE_WORKSPACE=codesboxs-llc
# Owner decision: comma-separated keys from GET /v1/payment-methods, or "*".
PAYMEGATE_PAYMENT_METHODS=
# Secrets: set with `wrangler secret put` / Pages secrets only. Never commit values.
# Sandbox uses a pmg_test_ key; production must use a separate live key.
PAYMEGATE_API_KEY=
PAYMEGATE_WEBHOOK_SECRET=
# Optional secret, only during webhook secret rotation (old value); delete afterwards.
PAYMEGATE_WEBHOOK_SECRET_PREVIOUS=
# Optional plain value: merchantId from an authenticated GET /v1/orders/{id} response.
PAYMEGATE_MERCHANT_ID=
# Owner-only capped (US$5.00) live verification orders via /api/admin/payments/verification.
PAYMEGATE_VERIFICATION_ENABLED=false