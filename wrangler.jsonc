{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codesboxs-site",
  "main": "src/worker/index.tsx",
  "compatibility_date": "2026-10-13",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "codesboxs", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "vars": { "ENVIRONMENT": "development", "PUBLIC_SITE_URL": "http://localhost:8787" },
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}